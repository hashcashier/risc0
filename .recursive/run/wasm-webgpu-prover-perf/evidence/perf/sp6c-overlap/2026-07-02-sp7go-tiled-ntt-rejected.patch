+/// Enable or disable the SP7go tiled strided-local NTT candidate for
+/// `batch_expand_into_evaluate_ntt`.
+///
+/// Default-off. When enabled, guard-matched FRI/check hot shapes replace the
+/// dynamic global `NTT_STEP_WGSL` passes with one workgroup-local strided
+/// kernel submitted together with the fused local prefix.
+pub fn set_batch_expand_strided_local_ntt_candidate_enabled(enabled: bool) {
+    WEBGPU_BATCH_EXPAND_STRIDED_LOCAL_NTT_CANDIDATE_ENABLED.with(|flag| flag.set(enabled));
+}
+
+pub(crate) fn batch_expand_strided_local_ntt_candidate_enabled() -> bool {
+    WEBGPU_BATCH_EXPAND_STRIDED_LOCAL_NTT_CANDIDATE_ENABLED.with(|flag| flag.get())
+}
+
+/// Number of `batch_expand_into_evaluate_ntt` calls that took the tiled
+/// strided-local candidate path.
+pub fn batch_expand_strided_local_ntt_dispatches() -> u64 {
+    WEBGPU_BATCH_EXPAND_STRIDED_LOCAL_NTT_DISPATCHES.with(|count| count.get())
+}
+
+pub(crate) fn record_batch_expand_strided_local_ntt_dispatch() {
+    WEBGPU_BATCH_EXPAND_STRIDED_LOCAL_NTT_DISPATCHES.with(|count| count.set(count.get() + 1));
+}
