{
  "browserName": "chrome",
  "goog:chromeOptions": {
    "args": [
      "--enable-unsafe-webgpu",
      "--enable-features=Vulkan",
      "--use-angle=vulkan",
      "--disable-vulkan-surface",
      "--ignore-gpu-blocklist",
      "--disable-gpu-watchdog",
      "--disable-hang-monitor",
      "--enable-dawn-features=allow_unsafe_apis,disable_adapter_blocklist"
    ]
  }
}
